@model List<MiniERPsystem.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0"><i class="bi bi-people me-2"></i>Customers
        <span class="badge bg-secondary ms-2 fs-6">@ViewBag.TotalCount</span>
    </h3>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus me-1"></i> Add Customer
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white py-3">
        <form method="get" asp-action="Index" class="d-flex gap-2">
            <input type="text" name="search" value="@ViewBag.Search"
                   class="form-control" placeholder="Search by name, phone, or email..." style="max-width:350px" />
            <button class="btn btn-outline-primary" type="submit">
                <i class="bi bi-search"></i> Search
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg"></i> Clear
                </a>
            }
        </form>
    </div>

    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-people fs-1 d-block mb-2"></i>
                <p class="mb-0">No customers found@(string.IsNullOrEmpty(ViewBag.Search as string) ? "" : $" for \"{ViewBag.Search}\"").</p>
                <a asp-action="Create" class="btn btn-primary mt-3">Add your first customer</a>
            </div>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>
                                <i class="bi bi-person-circle me-1 text-muted"></i>
                                <strong>@c.CustomerName</strong>
                            </td>
                            <td>@(c.Phone ?? "—")</td>
                            <td>@(c.Email ?? "—")</td>
                            <td class="text-center">
                                <a asp-action="SalesHistory" asp-route-id="@c.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-receipt me-1"></i>Sales History
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @if ((int)ViewBag.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center">
            <small class="text-muted">Page @ViewBag.CurrentPage of @ViewBag.TotalPages</small>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@i"
                               asp-route-search="@ViewBag.Search">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>
