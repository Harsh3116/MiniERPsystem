@model List<MiniERPsystem.Models.Sale>

@{
    ViewData["Title"] = "Sales";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0"><i class="bi bi-receipt me-2"></i>Sales</h3>
    <a class="btn btn-primary" asp-action="Create">
        <i class="bi bi-plus-lg me-1"></i> New Sale
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white py-3">
        <form method="get" asp-action="Index" class="d-flex gap-2">
            <input type="text" name="search" value="@ViewBag.Search"
                   class="form-control" placeholder="Search by customer name..." style="max-width:300px" />
            <button class="btn btn-outline-primary" type="submit">
                <i class="bi bi-search"></i> Search
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg"></i> Clear
                </a>
            }
        </form>
    </div>

    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-receipt fs-1 d-block mb-2"></i>
                <p class="mb-0">No sales found@(string.IsNullOrEmpty(ViewBag.Search as string) ? "" : $" for \"{ViewBag.Search}\"").</p>
                <a asp-action="Create" class="btn btn-primary mt-3">Create your first sale</a>
            </div>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th class="text-end">Total Amount</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sale in Model)
                    {
                        <tr>
                            <td class="text-muted small">@sale.Id</td>
                            <td>@sale.SaleDate.ToString("dd MMM yyyy")</td>
                            <td><i class="bi bi-person-circle me-1 text-muted"></i>@sale.CustomerName</td>
                            <td class="text-end fw-semibold">&#8377; @sale.TotalAmount.ToString("N2")</td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@sale.Id"
                                   class="btn btn-sm btn-outline-info me-1" title="View">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal-@sale.Id" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>

                        <!-- Delete Confirmation Modal -->
                        <div class="modal fade" id="deleteModal-@sale.Id" tabindex="-1">
                            <div class="modal-dialog modal-sm">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h6 class="modal-title text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Delete Sale</h6>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body small">
                                        Delete sale #@sale.Id for <strong>@sale.CustomerName</strong>? Stock will be restored.
                                    </div>
                                    <div class="modal-footer py-2">
                                        <button class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <form asp-action="DeleteConfirmed" asp-route-id="@sale.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </tbody>
            </table>
        }
    </div>

    @if ((int)ViewBag.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center">
            <small class="text-muted">Page @ViewBag.CurrentPage of @ViewBag.TotalPages</small>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@i"
                               asp-route-search="@ViewBag.Search">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>
